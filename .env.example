# ── ig-reply 憑證範本 / credentials template ──────────────────
# 複製這個檔成 .env 再填入你自己的值。.env 絕對不要上傳到 GitHub!
# Copy this file to .env and fill in your own values. NEVER commit .env!

# 你的 Meta App ID 與 App Secret(https://developers.facebook.com/apps)
# Your Meta App ID & Secret
FB_APP_ID=
FB_APP_SECRET=

# 以下 4 個由 `node oauth.js` 自動寫入,第一次不用手動填
# The 4 fields below are filled automatically by `node oauth.js`
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=
IG_USERNAME=

# Graph API 版本 / Graph API version
GRAPH_API_VERSION=v22.0
